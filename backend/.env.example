# ── Choose ONE provider (or leave all blank / set OFFLINE_MODE=1 for demo designs) ──

# Option 1: NVIDIA NIM — OpenAI-compatible, FREE credits at https://build.nvidia.com
# Get a key (starts with "nvapi-"), paste it here, and you're done.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Model to use (default shown). Good Verilog options:
#   qwen/qwen2.5-coder-32b-instruct      (default, strong code model)
#   mistralai/codestral-22b-instruct-v0.1
#   meta/llama-3.3-70b-instruct
LLM_MODEL=qwen/qwen2.5-coder-32b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # only change for self-hosted NIM

# Option 2: OpenAI
# OPENAI_API_KEY=sk-...

# Option 3: any other OpenAI-compatible endpoint (Groq, Together, Ollama, ...)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Force the built-in offline demo designs even if a key is set:
# OFFLINE_MODE=1

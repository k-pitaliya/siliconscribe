# ── Choose ONE provider (or leave all blank / set OFFLINE_MODE=1 for demo designs) ──
# Priority: OFFLINE_MODE=1 (forces offline) -> Opencode Zen -> NVIDIA NIM -> OpenAI -> offline fallback

# Option 0: Opencode Zen (remote, zero-budget) — PRIMARY, OpenAI-compatible free tier
# Get a key at https://opencode.ai (Zen dashboard). Remote, not local — no local zen needed.
# Set either OPENCODE_API_KEY or ZEN_API_KEY (aliases, OPENCODE takes precedence):
# OPENCODE_API_KEY=your_opencode_api_key_here
# ZEN_API_KEY=your_zen_api_key_here
# Base URL for Zen (optional, defaults to remote if not set):
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
# ZEN_BASE_URL=https://api.opencode.ai/v1          # alias; also accepts https://opencode.ai/api/v1
# Model for Zen (optional, defaults to opencode/muse-spark-1.2-contributor-free):
# ZEN_MODEL=opencode/muse-spark-1.2-contributor-free
# LLM_MODEL=opencode/muse-spark-1.2-contributor-free  # alias, ZEN_MODEL takes precedence
# Alternative Zen model:
# LLM_MODEL=opencode/gpt-5.3-codex-spark

# Option 1: NVIDIA NIM — OpenAI-compatible, FREE credits at https://build.nvidia.com
# Get a key (starts with "nvapi-"), paste it here, and you're done.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Model to use (default shown). Good Verilog options:
#   qwen/qwen2.5-coder-32b-instruct      (default, strong code model)
#   mistralai/codestral-22b-instruct-v0.1
#   meta/llama-3.3-70b-instruct
LLM_MODEL=qwen/qwen2.5-coder-32b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # only change for self-hosted NIM

# Option 2: OpenAI
# OPENAI_API_KEY=sk-...

# Option 3: any other OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama, ...)
# Example: OpenRouter free tier (used for the live validation in the report)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Example: Groq
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Generation budget / timeouts. Reasoning tokens count toward max_tokens; the
# client disables hidden reasoning unless reasoning_effort is explicitly set.
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=8192

# Force the built-in offline demo designs even if a key is set:
# OFFLINE_MODE=1

# Degraded mode: if the provider is unreachable before any live artifact is
# produced, the pipeline may fall back to a curated design and labels the run
# with fallback_notice. Once a live call succeeds, a later outage fails loudly
# instead of silently swapping the user's design.

# Per-stage model routing (optional). Put your strongest model on the stages that
# decide correctness, and a cheaper one on cosmetic stages. A model chosen
# explicitly per request still wins; unset stages use the default model above.
# LLM_MODEL_INTENT=...      # specification parsing
# LLM_MODEL_RTL=...         # RTL generation
# LLM_MODEL_TESTBENCH=...   # independent testbench generation (verification-critical)
# LLM_MODEL_FIX=...         # structured diagnosis and repair (verification-critical)
# LLM_MODEL_EXPLAIN=...     # design explanation (cosmetic; a small model is fine)

# --- Use your installed OpenCode app as the model (local, single-user) ---------
# OpenCode's free models are meant to run inside the OpenCode app, which signs in
# with your own account. This drives `opencode run` in an empty temp folder with the
# read-only "plan" agent. Tested live: deepseek-v4.1-flash-free (3/3 prompts PASS).
# LLM_PROVIDER=opencode-app
# LLM_MODEL=deepseek-v4.1-flash-free
# LLM_TIMEOUT_SECONDS=240
# OPENCODE_AGENT=plan

# --- Rate limiting behind a proxy -----------------------------------------------
# Leave unset when the app is reachable directly (the per-IP limit then uses the real
# socket address). Set to 1 ONLY behind a trusted reverse proxy (Render, nginx, ...),
# otherwise any caller could fake X-Forwarded-For to dodge the limit.
# TRUST_PROXY_HEADERS=1
# Simulator resource caps (memory cap is enforced on Linux only):
# SIM_MAX_MEMORY_MB=1024

# Simulations allowed to run at the same time (extra requests wait their turn)
# SIM_MAX_CONCURRENT=2

# Testbench strength: after a PASS, inject small bugs into the design and count how many the
# testbench catches (mutation testing). Costs about a second. Set STRENGTH_ENABLED=0 to skip.
# STRENGTH_ENABLED=1
# STRENGTH_MAX_MUTANTS=12
# STRENGTH_BUDGET_SECONDS=40

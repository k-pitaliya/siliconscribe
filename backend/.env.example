# ── Choose ONE provider (or leave all blank / set OFFLINE_MODE=1 for demo designs) ──
# Priority: OFFLINE_MODE=1 (forces offline) -> Opencode Zen -> NVIDIA NIM -> OpenAI -> offline fallback

# Option 0: Opencode Zen (remote, zero-budget) — PRIMARY, OpenAI-compatible free tier
# Get a key at https://opencode.ai (Zen dashboard). Remote, not local — no local zen needed.
# Set either OPENCODE_API_KEY or ZEN_API_KEY (aliases, OPENCODE takes precedence):
# OPENCODE_API_KEY=your_opencode_api_key_here
# ZEN_API_KEY=your_zen_api_key_here
# Base URL for Zen (optional, defaults to remote if not set):
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
# ZEN_BASE_URL=https://api.opencode.ai/v1          # alias; also accepts https://opencode.ai/api/v1
# Model for Zen (optional, defaults to opencode/muse-spark-1.2-contributor-free):
# ZEN_MODEL=opencode/muse-spark-1.2-contributor-free
# LLM_MODEL=opencode/muse-spark-1.2-contributor-free  # alias, ZEN_MODEL takes precedence
# Alternative Zen model:
# LLM_MODEL=opencode/gpt-5.3-codex-spark

# Option 1: NVIDIA NIM — OpenAI-compatible, FREE credits at https://build.nvidia.com
# Get a key (starts with "nvapi-"), paste it here, and you're done.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Model to use (default shown). Good Verilog options:
#   qwen/qwen2.5-coder-32b-instruct      (default, strong code model)
#   mistralai/codestral-22b-instruct-v0.1
#   meta/llama-3.3-70b-instruct
LLM_MODEL=qwen/qwen2.5-coder-32b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # only change for self-hosted NIM

# Option 2: OpenAI
# OPENAI_API_KEY=sk-...

# Option 3: any other OpenAI-compatible endpoint (Groq, Together, Ollama, ...)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Force the built-in offline demo designs even if a key is set:
# OFFLINE_MODE=1
